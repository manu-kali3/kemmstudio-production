# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Neon Postgres (primary app data + rate limiting). Optional for now: if unset/unavailable server runs in in-memory mode.
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/neondb?sslmode=require

# JWT secrets (use long random values in production)
JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
ACCESS_TOKEN_TTL=15m

# Email (Resend) for 2FA codes
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Kemmstudio Production <onboarding@resend.dev>

# Session/heartbeat
HEARTBEAT_TIMEOUT_MS=90000

# Seed (optional overrides)
SEED_ADMIN_EMAIL=admin@kemmstudio.com
SEED_ADMIN_PASSWORD=Admin@12345

# Social links
WHATSAPP_LINK=https://wa.me/254700000000
FACEBOOK_LINK=https://facebook.com/kemmstudioproduction
INSTAGRAM_LINK=https://instagram.com/kemmstudioproduction
